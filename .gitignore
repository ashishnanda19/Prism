# Build output
build/
build-*/
cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib

# Prism binaries
/prism
/prism-lite
/prism-classic
/prism-dump
/dpi_engine
/dpi_simple
/prism_tests

# Generated captures
/output.pcap
*.out.pcap
out-*.pcap

# Fuzzing artifacts (the seed corpus under fuzz/corpus/ IS tracked)
crash-*
timeout-*
oom-*
leak-*
fuzz/corpus/**/*.min

# Editor / OS
.DS_Store
.vscode/
.idea/
compile_commands.json

# pcap-derived seeds are regenerated by fuzz/seed_corpus.py, not committed
fuzz/corpus/packet_parser/frame_*
fuzz/corpus/pcap_reader/capture_full

# stray output file from `prism-lite in.pcap -o out` (prism-lite has no -o)
/-o
